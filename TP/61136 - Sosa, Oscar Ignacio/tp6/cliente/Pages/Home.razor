@page "/"
@using cliente.Services
@inject ApiService ApiService

<PageTitle>Inicio</PageTitle>

<div class="container">
    <div class="row mb-4">
        <div class="col-12">
            <h1>Comunicación Cliente-Servidor</h1>
        </div>
    </div>
    
    <div class="row mb-4">
        <div class="col-12">
            <button class="btn btn-primary" @onclick="ObtenerDatosDelServidor" disabled="@estaCargando">
                @(estaCargando ? "Cargando..." : "Obtener datos del servidor")
            </button>
        </div>
    </div>

    <div class="row">
        <div class="col-12">

            @if (estaCargando)
            {
                <div class="alert alert-info">Cargando datos...</div>
            }

            @if (datosRespuesta != null)
            {
                <div class="card" style="width: 300px;">
                    <div class="card-header">
                        Respuesta del servidor
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">@datosRespuesta.Mensaje</h5>
                        <p class="card-text">
                            Fecha: @(datosRespuesta.Fecha != null ? datosRespuesta.Fecha.ToString("dd/MM/yyyy HH:mm:ss") : "Fecha no disponible")
                        </p>
                    </div>
                </div>
            }

            @if (mensajeError != null)
            {
                <div class="alert alert-danger">
                    Error: @mensajeError
                </div>
            }

        </div>
    </div>
</div>

@code {
    private DatosRespuesta datosRespuesta;
    private string mensajeError;
    private bool estaCargando = false;

    private async Task ObtenerDatosDelServidor()
    {
        try
        {
            estaCargando = true:
            mensajeError = null;
            datosRespuesta = await ApiService.ObtenerDatosAsync();
        }
        catch (HttpRequestException httpEx)
        {
            
        }
    }
}