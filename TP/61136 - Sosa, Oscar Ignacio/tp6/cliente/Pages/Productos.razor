@using cliente.Models
@using cliente.Services
@inject ApiService ApiService

<h2>Catálogo de Productos</h2>

@if (productos == null)
{
    <p><em>Cargando productos...</em></p>
}
else if (!productos.Any())
{
    <p>No hay productos para mostrar.</p>
}
else
{
    <div class="row">
        @foreach (var producto in productos)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <img src="@producto.ImagenUrl" class="card-img-top" alt="@producto.Nombre" />
                    <div class="card-body">
                        <h5 class="card-title">@producto.Nombre</h5>
                        <p class="card-text">Precio: @producto.Precio.ToString("C")</p>
                        <button class="btn btn-primary" @onclick="() => AgregarAlCarrito(producto)">Agregar al carrito</button>
                    </div>
                </div>
            </div>
        }
    </div>
}

<h3>Carrito de Compras</h3>

@if (!carrito.Any())
{
    <p>Tu carrito está vacío.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Cantidad</th>
                <th>Precio unitario</th>
                <th>Subtotal</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in carrito)
            {
                <tr>
                    <td>@item.Producto.Nombre</td>
                    <td>@item.Cantidad</td>
                    <td>@item.Producto.Precio.ToString("C")</td>
                    <td>@(item.Cantidad * item.Producto.Precio).ToString("C")</td>
                    <td>
                        <button class="btn btn-danger btn-sm" @onclick="() => QuitarDelCarrito(item.Producto)">Quitar</button>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3"><strong>Total:</strong></td>
                <td colspan="2"><strong>@Total.ToString("C")</strong></td>
            </tr>
        </tfoot>
    </table>
}

@code {
    private List<Producto> productos;
    private List<ItemCarrito> carrito = new();

    protected override async Task OnInitializedAsync()
    {
        productos = await ApiService.ObtenerProductosAsync();
    }

    private void AgregarAlCarrito(Producto producto)
    {
        var item = carrito.FirstOrDefault(i => i.Producto.Id == producto.Id);
        if (item == null)
        {
            carrito.Add(new ItemCarrito { Producto = producto, Cantidad = 1 });
        }
        else
        {
            item.Cantidad++;
        }
    }

    private void QuitarDelCarrito(Producto producto)
    {
        var item = carrito.FirstOrDefault(i => i.Producto.Id == producto.Id);
        if (item != null)
        {
            item.Cantidad--;
            if (item.Cantidad == 0)
            {
                carrito.Remove(item);
            }
        }
    }

    private decimal Total => carrito.Sum(i => i.Producto.Precio * i.Cantidad);

    public class ItemCarrito
    {
        public Producto Producto { get; set; }
        public int Cantidad { get; set; }
    }
}
